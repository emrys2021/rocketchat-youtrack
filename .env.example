PORT=8080
NODE_ENV=production

# OpenAI-compatible Chat Completions endpoint.
# Use a full endpoint URL because this app calls fetch() directly.
# 本后端容器服务没有引入 OpenAI SDK，所以需要使用完整的 endpoint URL。
LLM_API_URL=http://<从 GPU Stack 部署的推理服务获取>/chat/completions
LLM_API_KEY=<从 GPU Stack 部署的推理服务获取>
LLM_MODEL=<从 GPU Stack 部署的推理服务获取>
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=2200

# YouTrack MCP Streamable HTTP endpoint.
# Confirm the exact path in your YouTrack 2026.1 MCP settings.
MCP_URL=http://<youtrack容器服务地址>/mcp
MCP_API_KEY=<youtrack用户profile下创建的permanent token>
MCP_AUTH_HEADER=Authorization
MCP_AUTH_SCHEME=Bearer
MCP_PROTOCOL_VERSION=2025-06-18
MCP_TIMEOUT_MS=30000
MCP_TOOLS_CACHE_SECONDS=300
MCP_MAX_TOOL_ROUNDS=10
MCP_RESULT_MAX_CHARS=30000

# Keep this strict. These are read-only tools.
MCP_ALLOWED_TOOLS=search_issues,get_issue,get_issue_comments,search_articles,get_article
MCP_BLOCKED_TOOL_WORDS=create,update,delete,remove,write,comment,transition,assign,execute,import,log

# YouTrack REST is used only for read-only work item lookup:
# GET /api/issues/{issueID}/timeTracking/workItems
# If omitted, YOUTRACK_BASE_URL is inferred from MCP_URL and YOUTRACK_API_TOKEN reuses MCP_API_KEY.
YOUTRACK_BASE_URL=
YOUTRACK_API_TOKEN=
YOUTRACK_TIMEOUT_MS=30000
YOUTRACK_WORK_ITEMS_LIMIT=20
YOUTRACK_ENRICH_ISSUE_LIMIT=3
YOUTRACK_COMMENTS_LIMIT=20

# ============================================================================
# Rocket.Chat bot 账户凭据
#
# bot-login (realtime) 模式把 Rocket.Chat 凭据分成两类：
#   1. 收消息登录（DDP）：ROCKET_BOT_USERNAME + ROCKET_BOT_PASSWORD
#      或 resume token（PAT 或登录接口返回的 authToken）
#   2. 发 REST 回复：ROCKET_REST_USER_ID + ROCKET_REST_PAT（推荐）
#      或 ROCKET_REST_USER_ID + ROCKET_REST_LOGIN_AUTH_TOKEN（登录接口返回的 authToken）
#
# 纯 PAT 模式（生产环境禁止配置 bot 密码时使用，推荐）：
#   PAT 可直接用于 DDP login({ resume })——Rocket.Chat 把 PAT 和普通 login token
#   都存在 services.resume.loginTokens 里，DDP resume 校验不区分类型。因此只配
#   ROCKET_REST_USER_ID + ROCKET_REST_PAT 即可：PAT 同时用于 DDP 登录和 REST 回复，
#   无需 bot 密码、无需任何服务器端环境变量。
#   默认 ROCKET_MESSAGE_STREAM_MODE=auto：先走 notification + rooms-changed 探针；
#   如果 rooms-changed 发现可响应消息而 notification 未在 fallback 窗口送达，
#   自动切到 stream-room-messages 的 __my_messages__ 可靠消息流。
# ============================================================================
ROCKET_URL=http://rocketchat:3000

# [bot-login 推荐] 收消息登录用：bot 账户用户名 + 密码登录 Realtime/DDP API。
# ROCKET_BOT_USERNAME 同时也是频道里触发 bot 的 @ 提及名（@<用户名>）。
ROCKET_BOT_USERNAME=youtrack-bot
ROCKET_BOT_PASSWORD=<bot 账户登录密码>

# [bot-login 可选] 高级用法：不用密码时，才填 DDP resume token。
# 这里填 Rocket.Chat 登录接口返回的 authToken，或 bot 账户 PAT。
ROCKET_DDP_RESUME_TOKEN=

# [bot-login 推荐] 发回复用：REST chat.sendMessage 的 X-User-Id / X-Auth-Token。
# 推荐填 bot 账户的 PAT。PAT 获取位置：bot 账户 → My Account → Personal Access Tokens。
ROCKET_REST_USER_ID=<bot 账户 User Id>
ROCKET_REST_PAT=<bot 账户 Personal Access Token>

# [bot-login 可选] 如果不用 PAT，也可以用登录接口返回的 authToken 作为 REST X-Auth-Token。
# ROCKET_REST_PAT 和 ROCKET_REST_LOGIN_AUTH_TOKEN 二选一；两者都填时优先使用 PAT。
ROCKET_REST_LOGIN_AUTH_TOKEN=

# [bot-login 不需要] 仅 outgoing webhook 模式（server.js）必填。
ROCKET_WEBHOOK_TOKEN=<创建 Rocket.Chat outgoing webhook时生成的token，也可以在这边先指定一个随机字符串，后续在创建 webhook 时使用相同的 token>
ROCKET_REPLY_IN_THREAD=true
ROCKET_POST_PROGRESS=true
ROCKET_MESSAGE_MAX_CHARS=3500
ROCKET_TIMEOUT_MS=15000
# bot-login 接收模式：auto 先用 notification，漏消息再切到 __my_messages__；
# notification 强制只用通知流；my_messages 强制只用 __my_messages__。
ROCKET_MESSAGE_STREAM_MODE=auto
ROCKET_NOTIFICATION_FALLBACK_MS=2000
# Safety guard for direct-message auto-reply loops and overly broad outgoing webhooks.
ROCKET_IGNORE_AUTO_REPLIES=true
ROCKET_LOOP_WINDOW_MS=60000
ROCKET_LOOP_MAX_EVENTS=4
# Ignores repeated delivery of the same Rocket.Chat message_id.
ROCKET_MESSAGE_DEDUPE_TTL_MS=600000
ROCKET_MESSAGE_DEDUPE_MAX_ENTRIES=1000

# Protects /ask, /debug/tools, and /debug/work-items.
ADMIN_TOKEN=<访问后端容器服务的 /ask, /debug/tools, 和 /debug/work-items 接口时需要提供的 token，建议使用随机字符串>
